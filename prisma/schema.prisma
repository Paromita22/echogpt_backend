generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ProviderType {
  OPENAI
  CLAUDE
  GEMINI
}

enum Plan {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
}

enum MessageRole {
  USER
  ASSISTANT
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model User {
  id              Int      @id @default(autoincrement())
  email           String   @unique
  password        String
  name            String
  isEmailVerified Boolean  @default(false)
  roleId          Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  role          Role           @relation(fields: [roleId], references: [id])
  sessions      Session[]
  subscription  Subscription?
  conversations Conversation[]
  webSearches   WebSearch[]
  usageLogs     ApiUsageLog[]
}

model Session {
  id           Int      @id @default(autoincrement())
  userId       Int
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subscription {
  id           Int                @id @default(autoincrement())
  userId       Int                @unique
  plan         Plan               @default(FREE)
  status       SubscriptionStatus @default(ACTIVE)
  requestLimit Int                @default(50)
  requestsUsed Int                @default(0)
  periodEnd    DateTime
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiProvider {
  id           Int          @id @default(autoincrement())
  name         String
  type         ProviderType
  model        String
  apiKey       String
  isEnabled    Boolean      @default(true)
  isDefault    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  conversations Conversation[]
  usageLogs     ApiUsageLog[]
}

model Conversation {
  id         Int      @id @default(autoincrement())
  userId     Int
  providerId Int?
  title      String
  createdAt  DateTime @default(now())

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider AiProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([userId])
}

model Message {
  id             Int         @id @default(autoincrement())
  conversationId Int
  role           MessageRole
  content        String
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model WebSearch {
  id        Int      @id @default(autoincrement())
  userId    Int
  query     String
  result    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ApiUsageLog {
  id             Int      @id @default(autoincrement())
  userId         Int?
  providerId     Int?
  endpoint       String
  method         String
  statusCode     Int
  responseTimeMs Int
  createdAt      DateTime @default(now())

  user     User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider AiProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
}